# Insert In Style: local path configuration.
# Edit the values, then run:  python tools/set_paths.py
# (writes these paths into every script/config/notebook that uses a {{TOKEN}} placeholder;
#  python tools/set_paths.py --reverse puts the placeholders back before committing.)

# This repository (leave empty to auto-detect).
PROJECT_ROOT=

# Base models and auxiliary weights:
#   FLUX.1-dev, FLUX.1-Kontext-dev, clip-vit-large-patch14, clip-vit-base-patch32,
#   dinov2-large, CSD-ViT-L, GroundingDINO + SAM 2.1 checkpoints, Qwen3-VL-8B-Instruct, ...
MODELS_ROOT=/path/to/models

# DreamFuse dataset root (the HF release; images unpacked under extracted_data/).
DREAMFUSE_ROOT=/path/to/DreamFuse

# Stylized composites produced in data_generation/1_stylization
#   kontext/<Style>/...   (FLUX.1-Kontext + style LoRAs)
#   csgo/...  cast/...    (reference-based stylization with Style30K references)
STYLIZED_ROOT=/path/to/stylized

# Baseline outputs and their benchmark JSONs (AnyDoor, AIComposer, DreamFuse, TALE, TF-ICON, ...).
BASELINES_ROOT=/path/to/baselines

# Other datasets used by individual scripts (Subjects200K, OmniStyle-150k, style30k, ...).
DATASETS_ROOT=/path/to/datasets

# Scratch space for intermediate outputs of the exploratory scripts.
WORK_ROOT=/path/to/work
